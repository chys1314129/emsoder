{
  "name": "emsoder-desktop",
  "productName": "EMSoder",
  "version": "2.0.0",
  "description": "EMSoder desktop — Quest-first UI (board / stream / review), free custom models",
  "main": "src/main/main.js",
  "author": "EMSoder",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --win --x64 --dir -c.npmRebuild=false",
    "pack:portable": "electron-builder --win portable --x64 -c.npmRebuild=false",
    "dist": "electron-builder",
    "test:pty": "node scripts/test-pty.js",
    "test:debug": "node scripts/test-debug-run.js",
    "test:skills": "node scripts/test-skills.js",
    "test:skill-install": "node scripts/test-skill-install.js",
    "test:apply-diff": "node scripts/test-apply-diff.js",
    "test:memory": "node scripts/test-memory.js",
    "fix-pty": "node scripts/fix-pty.js",
    "postinstall": "node scripts/fix-pty.js || echo fix-pty skipped",
    "sync-skills": "node scripts/sync-bundled-skills.js",
    "sync-runtime": "node scripts/sync-skill-runtime.js",
    "sync-all": "node scripts/sync-bundled-skills.js && node scripts/sync-skill-runtime.js",
    "fix-electron": "node -e \"process.env.ELECTRON_MIRROR='https://npmmirror.com/mirrors/electron/'; require('child_process').execSync('node node_modules/electron/install.js',{stdio:'inherit',env:process.env})\""
  },
  "build": {
    "appId": "com.emsoder.desktop",
    "productName": "EMSoder",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "resources/icon.png",
      "resources/icon-64.png",
      "resources/core-skills/**/*",
      "package.json",
      "node_modules/monaco-editor/min/**/*",
      "node_modules/monaco-editor/package.json",
      "node_modules/xterm/**/*",
      "node_modules/xterm-addon-fit/**/*",
      "node_modules/xterm-addon-web-links/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*",
      "node_modules/ws/**/*",
      "node_modules/docx/**/*",
      "node_modules/pdfkit/**/*",
      "node_modules/pptxgenjs/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/core-skills",
        "to": "core-skills",
        "filter": ["**/*"]
      },
      {
        "from": "resources/bundled-skills",
        "to": "bundled-skills",
        "filter": ["**/*"]
      },
      {
        "from": "resources/skill-runtime",
        "to": "skill-runtime",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "node_modules/monaco-editor/**",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "resources/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "EMSoder"
    },
    "portable": {
      "artifactName": "EMSoder-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "docx": "^9.7.1",
    "monaco-editor": "^0.52.2",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "ws": "^8.18.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  }
}
