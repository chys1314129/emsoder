{
  "name": "emsoder-desktop",
  "productName": "EMSoder",
  "version": "2.6.0",
  "description": "EMSoder desktop — open a folder, talk, review file changes. Bring your own model.",
  "main": "src/main/main.js",
  "author": "EMSoder",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "vendor": "node scripts/vendor-assets.js",
    "build:host": "node scripts/build-host.js",
    "tauri": "tauri",
    "tauri:dev": "node scripts/vendor-assets.js && tauri dev",
    "tauri:build": "node scripts/build-host.js && node scripts/vendor-assets.js && tauri build",
    "host": "node host/host.js",
    "test:host-boot": "node scripts/test-host-boot.js",
    "test:bridge-parity": "node scripts/test-bridge-parity.js",
    "test:dpapi-compat": "node scripts/test-dpapi-compat.js",
    "test:chat": "node scripts/test-chat-flow.js",
    "test:tauri": "node scripts/test-bridge-parity.js && node scripts/test-host-boot.js && node scripts/test-dpapi-compat.js",
    "pack": "electron-builder --win --x64 --dir -c.npmRebuild=false",
    "pack:portable": "electron-builder --win portable --x64 -c.npmRebuild=false",
    "dist": "electron-builder",
    "test": "node scripts/run-all-tests.js",
    "test:pty": "node scripts/test-pty.js",
    "test:debug": "node scripts/test-debug-run.js",
    "test:skills": "node scripts/test-skills.js",
    "test:skill-install": "node scripts/test-skill-install.js",
    "test:apply-diff": "node scripts/test-apply-diff.js",
    "test:file-changes": "node scripts/test-file-changes.js",
    "test:session": "node scripts/test-session.js",
    "test:mcp": "node scripts/test-mcp.js",
    "test:memory": "node scripts/test-memory.js",
    "test:providers": "node scripts/test-providers.js",
    "test:pollinations": "node scripts/test-pollinations.js",
    "test:keyless-integration": "node scripts/test-keyless-integration.js",
    "test:keyless-ui": "node scripts/test-keyless-ui.js",
    "test:confirm": "node scripts/test-confirm.js",
    "fix-pty": "node scripts/fix-pty.js",
    "postinstall": "node scripts/fix-pty.js || echo fix-pty skipped",
    "sync-skills": "node scripts/sync-bundled-skills.js",
    "sync-runtime": "node scripts/sync-skill-runtime.js",
    "sync-all": "node scripts/sync-bundled-skills.js && node scripts/sync-skill-runtime.js",
    "build:pi-sidecar": "node scripts/build-pi-sidecar.js",
    "fix-electron": "node -e \"process.env.ELECTRON_MIRROR='https://npmmirror.com/mirrors/electron/'; require('child_process').execSync('node node_modules/electron/install.js',{stdio:'inherit',env:process.env})\"",
    "test:documents": "node scripts/test-documents.js",
    "test:image-gen-config": "node scripts/test-image-gen-config.js",
    "test:pi-sidecar": "node scripts/test-pi-sidecar.js",
    "test:pi-skills": "node scripts/test-pi-skills.js",
    "test:pi-compact": "node scripts/test-pi-compact.js",
    "test:pi-soak": "node scripts/test-pi-soak.js",
    "test:pi-transaction": "node scripts/test-pi-transaction.js",
    "test:pi-nested-adapter": "node scripts/test-pi-nested-adapter.js",
    "test:pi-token-stats": "node scripts/test-pi-token-stats.js",
    "test:workspace-task-pool": "node scripts/test-workspace-task-pool.js",
    "test:parallel-session-pinning": "node scripts/test-parallel-session-pinning.js",
    "test:context-history": "node scripts/test-context-history.js",
    "test:session-context-mutation": "node scripts/test-session-context-mutation.js",
    "test:execution-env": "node scripts/test-execution-env.js",
    "test:credential-catalog": "node scripts/test-credential-catalog.js",
    "test:config-secret-projection": "node scripts/test-config-secret-projection.js",
    "test:prompt-modal": "node scripts/test-prompt-modal.js",
    "test:web-tools": "node scripts/test-web-tools.js",
    "preflight:share": "node scripts/preflight-share.js",
    "test:release-config": "node scripts/test-release-config.js",
    "release:check": "node scripts/release/prepare-runtime.js --check",
    "release:prepare-runtime": "node scripts/release/prepare-runtime.js",
    "release:collect": "node scripts/release/validate-release.js --collect"
  },
  "build": {
    "appId": "com.emsoder.desktop",
    "productName": "EMSoder",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "resources/icon.png",
      "resources/icon.ico",
      "resources/icon-64.png",
      "resources/core-skills/**/*",
      "package.json",
      "node_modules/monaco-editor/min/**/*",
      "node_modules/monaco-editor/package.json",
      "node_modules/xterm/**/*",
      "node_modules/xterm-addon-fit/**/*",
      "node_modules/xterm-addon-web-links/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*",
      "node_modules/ws/**/*",
