      "node_modules/typebox/**/*",
      "node_modules/diff/**/*",
      "node_modules/ignore/**/*",
      "node_modules/yaml/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/core-skills",
        "to": "core-skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bundled-skills",
        "to": "bundled-skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/skill-runtime",
        "to": "skill-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/agent-runtime",
        "to": "agent-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/monaco-editor/**",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "EMSoder"
    },
    "portable": {
      "artifactName": "EMSoder-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "electron": "^33.2.0",
